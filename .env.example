LOOMTABLE_POSTGRES_PASSWORD=change-me
# Native default and Compose host publication: 127.0.0.1:31201
# Optional: 30d, 90d, 365d, or forever.
LOOMTABLE_CHANGE_RETENTION=30d
LOOMTABLE_IDEMPOTENCY_RETENTION=30d
# Attachment P1 defaults: persistent volume path and 50 MiB per managed file.
LOOMTABLE_ATTACHMENT_ROOT=./data/attachments
LOOMTABLE_ATTACHMENT_MAX_BYTES=52428800
LOOMTABLE_ATTACHMENTS_ENABLED=true

